# Database Configuration
# PostgreSQL is required
DATABASE_URL=postgresql://username:password@localhost:5432/educompose_db

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Neo4j Desktop Configuration (Local)
# ============================================
# For Neo4j Desktop (local development):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_desktop_password_here
NEO4J_DATABASE=neo4j

# ============================================
# Neo4j Aura Configuration (Cloud) - Commented out when using Desktop
# ============================================
# For Neo4j Aura (cloud/production):
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_aura_password_here
# NEO4J_DATABASE=neo4j

# Notes:
# - Use Desktop (bolt://) for local development
# - Use Aura (neo4j+s://) for production/cloud
# - Comment out the one you're not using
# - Desktop password is set when creating the database in Neo4j Desktop

