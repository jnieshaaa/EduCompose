# Database Configuration
# For SQLite (development - recommended for getting started):
DATABASE_URL=sqlite:///./educompose.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/educompose_db
# Example: postgresql://educompose_user:your_password@localhost:5432/educompose_db

# Database Connection Pool Settings (PostgreSQL only)
# SQL_ECHO=false  # Set to true to log all SQL queries (useful for debugging)

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Neo4j Configuration (Optional - for knowledge graph storage)
# For Neo4j Aura (recommended for production):
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# For Neo4j Desktop (local development):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here
# NEO4J_DATABASE=neo4j