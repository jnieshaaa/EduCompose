# Database Configuration
# Database connection string
DATABASE_URL=sqlite:///./educompose.db
# Example for PostgreSQL: postgresql://user:password@localhost:5432/educompose
# Example for SQLite: sqlite:///./educompose.db

# Authentication Mode
LOCAL_AUTH_AUTO_CREATE=true
DEFAULT_USER_ROLE=teacher

# Database Connection Pool Settings
# SQL_ECHO=false  # Set to true to log all SQL queries (useful for debugging)

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM API Keys (Optional - for enhanced grammar checking)
# OpenAI API Key - Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key - Get from https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional - defaults to trying: models/gemini-2.5-flash, gemini-2.5-flash, models/gemini-flash-latest, etc.)
# Recommended: models/gemini-2.5-flash (fastest) or models/gemini-2.5-pro (more capable)
# Other options: models/gemini-flash-latest, models/gemini-pro-latest, models/gemini-2.0-flash
# GEMINI_MODEL_NAME=models/gemini-2.5-flash