# Database Configuration
# Supabase PostgreSQL connection string
# Get this from your Supabase project settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example: postgresql://postgres:your_password@db.abcdefghijklmnop.supabase.co:5432/postgres

# Authentication Mode
# Set SUPABASE_AUTH_ENABLED=true to use Supabase Auth.
# Leave it false to use local DB-only auth (no Supabase account needed).
SUPABASE_AUTH_ENABLED=false
LOCAL_AUTH_AUTO_CREATE=true
DEFAULT_USER_ROLE=teacher

# Supabase Configuration (only required when SUPABASE_AUTH_ENABLED=true)
# Get these from your Supabase project settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Example: SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# Database Connection Pool Settings
# SQL_ECHO=false  # Set to true to log all SQL queries (useful for debugging)

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM API Keys (Optional - for enhanced grammar checking)
# OpenAI API Key - Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key - Get from https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional - defaults to trying: models/gemini-2.5-flash, gemini-2.5-flash, models/gemini-flash-latest, etc.)
# Recommended: models/gemini-2.5-flash (fastest) or models/gemini-2.5-pro (more capable)
# Other options: models/gemini-flash-latest, models/gemini-pro-latest, models/gemini-2.0-flash
# GEMINI_MODEL_NAME=models/gemini-2.5-flash